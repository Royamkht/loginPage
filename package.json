{
  "name": "js-fundamental",
  "version": "1.0.0",
  "description": "Simple login web app with API and CI/CD tests",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "test:ui": "node ./node_modules/@playwright/test/cli.js test tests/ui.spec.ts --project=chromium",
    "playwright:install": "node ./node_modules/@playwright/test/cli.js install"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.2",
    "ajv": "^8.20.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.0"
  }
}
